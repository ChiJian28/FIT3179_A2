{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Classified choropleth of the 2023/24 coastal drowning rate with interactive normalized metric selector.",
  "width": 920,
  "height": 450,
  "padding": {
    "left": 10,
    "right": 10,
    "top": 10,
    "bottom": 10
  },
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -132,
      0
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "params": [
    {
      "name": "label_mode",
      "value": "rate",
      "bind": {
        "input": "select",
        "options": [
          "rate",
          "rate_10yr",
          "beyond_pct",
          "clubs_per_1000km"
        ],
        "labels": [
          "2023/24 rate (per 100k)",
          "10-year avg rate (per 100k)",
          "Share >1 km from patrol (%)",
          "SLS clubs per 1,000 km coast"
        ],
        "name": "Inspect normalized state metric: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/au-states.geojson?v=33",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "lookup": "properties.STATE_NAME",
          "from": {
            "data": {
              "url": "data/states.csv?v=33",
              "format": {
                "type": "csv"
              }
            },
            "key": "state",
            "fields": [
              "code",
              "deaths",
              "rate",
              "rate_10yr",
              "rate_class",
              "beyond_pct",
              "clubs",
              "clubs_per_1000km",
              "pop_m"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1.3
      },
      "encoding": {
        "color": {
          "field": "rate_class",
          "type": "nominal",
          "scale": {
            "domain": [
              "0.38\u20130.48",
              "0.69\u20130.73",
              "1.74",
              "No single-year rate"
            ],
            "range": [
              "#f3cfc9",
              "#c95b52",
              "#7a1f1c",
              "#e7e0d6"
            ]
          },
          "legend": {
            "title": "2023/24 deaths per 100,000 people (normalized rate)",
            "orient": "bottom",
            "columns": 4,
            "direction": "horizontal",
            "labelLimit": 200
          }
        },
        "tooltip": [
          {
            "field": "properties.STATE_NAME",
            "title": "State / Territory",
            "type": "nominal"
          },
          {
            "field": "rate",
            "title": "2023/24 rate (per 100k)",
            "type": "quantitative",
            "format": ".2f"
          },
          {
            "field": "rate_10yr",
            "title": "10-year avg rate (per 100k)",
            "type": "quantitative",
            "format": ".2f"
          },
          {
            "field": "beyond_pct",
            "title": "Deaths >1 km from service (%)",
            "type": "quantitative"
          },
          {
            "field": "clubs_per_1000km",
            "title": "Clubs per 1,000 km coast",
            "type": "quantitative",
            "format": ".1f"
          },
          {
            "field": "pop_m",
            "title": "ABS population (millions)",
            "type": "quantitative",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/states.csv?v=33",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/labels.csv?v=33",
              "format": {
                "type": "csv"
              }
            },
            "key": "state",
            "fields": [
              "lon",
              "lat"
            ]
          }
        },
        {
          "calculate": "label_mode == 'rate_10yr' ? datum.code + '  ' + datum.rate_10yr : label_mode == 'beyond_pct' ? datum.code + '  ' + datum.beyond_pct + '%' : label_mode == 'clubs_per_1000km' ? datum.code + '  ' + datum.clubs_per_1000km + '/1k km' : (datum.deaths === '' || datum.deaths == null ? datum.code + ' (no 1-yr)' : datum.code + '  ' + datum.rate)",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Source Sans 3, sans-serif",
        "fontSize": 13,
        "fontWeight": 600,
        "color": "#1c2430",
        "dy": 2
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 146.4,
            "lat": -44.2,
            "note": "Tasmania: 1.74 per 100k (3.1\u00d7 national rate)"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "dy": 8,
        "font": "Source Sans 3, sans-serif",
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#7a1f1c"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "note",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": "#d8e6ee",
    "font": "Source Sans 3, sans-serif",
    "axis": {
      "labelFont": "Source Sans 3, sans-serif",
      "titleFont": "Source Sans 3, sans-serif",
      "labelFontSize": 12.5,
      "titleFontSize": 12.5,
      "titleFontWeight": 600,
      "labelColor": "#1c2430",
      "titleColor": "#1c2430",
      "domainColor": "#bfb6aa",
      "tickColor": "#bfb6aa",
      "grid": false,
      "labelPadding": 6,
      "titlePadding": 8,
      "labelLimit": 220
    },
    "legend": {
      "labelFont": "Source Sans 3, sans-serif",
      "titleFont": "Source Sans 3, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#1c2430",
      "titleColor": "#1c2430",
      "symbolStrokeWidth": 0,
      "labelLimit": 240,
      "titleLimit": 280
    },
    "header": {
      "labelFont": "Source Sans 3, sans-serif",
      "titleFont": "Source Sans 3, sans-serif",
      "labelFontSize": 13.5,
      "labelColor": "#1c2430",
      "labelFontWeight": 600
    },
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Source Sans 3, sans-serif",
      "color": "#1c2430",
      "fontSize": 13.5,
      "fontWeight": 600,
      "subtitleFont": "Source Sans 3, sans-serif",
      "subtitleFontSize": 11.5,
      "subtitleColor": "#786f66",
      "anchor": "start"
    }
  }
}
