{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Two-ring hierarchical sunburst with distinct categorical hues and direct percentage annotations on every slice.",
  "width": 360,
  "height": 350,
  "padding": {
    "left": 16,
    "right": 16,
    "top": 8,
    "bottom": 8
  },
  "layer": [
    {
      "data": {
        "url": "data/sunburst_inner.csv?v=33",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "calculate": "format(datum.pct, '.1f') + '%'",
          "as": "pct_str"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "arc",
            "innerRadius": 52,
            "outerRadius": 114,
            "stroke": "#ffffff",
            "strokeWidth": 2
          },
          "encoding": {
            "theta": {
              "field": "count",
              "type": "quantitative",
              "stack": true
            },
            "order": {
              "field": "ord",
              "type": "quantitative"
            },
            "color": {
              "field": "label",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Beach \u00b7 56.0% (84)",
                  "Offshore \u00b7 18.7% (28)",
                  "Rock/cliff \u00b7 12.7% (19)",
                  "Other coastal \u00b7 12.7% (19)"
                ],
                "range": [
                  "#b84a39",
                  "#1f6f78",
                  "#8a6232",
                  "#6b5b7b"
                ]
              },
              "legend": {
                "title": "Inner ring \u00b7 Coastal location (% of 150)",
                "orient": "bottom",
                "columns": 2,
                "labelLimit": 180
              }
            },
            "tooltip": [
              {
                "field": "slice",
                "type": "nominal",
                "title": "Location"
              },
              {
                "field": "pct",
                "type": "quantitative",
                "title": "Share of total (%)",
                "format": ".1f"
              },
              {
                "field": "count",
                "type": "quantitative",
                "title": "Drowning deaths (n)"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "radius": 83,
            "font": "Source Sans 3, sans-serif",
            "fontSize": 11.5,
            "fontWeight": 700,
            "color": "#ffffff"
          },
          "encoding": {
            "theta": {
              "field": "count",
              "type": "quantitative",
              "stack": true
            },
            "order": {
              "field": "ord",
              "type": "quantitative"
            },
            "text": {
              "field": "pct_str",
              "type": "nominal"
            }
          }
        }
      ]
    },
    {
      "data": {
        "url": "data/sunburst_outer.csv?v=33",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "calculate": "datum.ord == 1 ? 'Unknown;23.3%' : datum.ord == 2 ? 'Rip;19.3%' : datum.ord == 3 ? 'No rip;13.3%' : datum.ord == 4 ? '18.7%' : datum.ord == 5 ? '12.7%' : '12.7%'",
          "as": "outer_pct_raw"
        },
        {
          "calculate": "split(datum.outer_pct_raw, ';')",
          "as": "outer_pct_str"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "arc",
            "innerRadius": 120,
            "outerRadius": 168,
            "stroke": "#ffffff",
            "strokeWidth": 2
          },
          "encoding": {
            "theta": {
              "field": "count",
              "type": "quantitative",
              "stack": true
            },
            "order": {
              "field": "ord",
              "type": "quantitative"
            },
            "color": {
              "field": "slice",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Beach \u00b7 Rip unknown",
                  "Beach \u00b7 Rip confirmed",
                  "Beach \u00b7 No rip",
                  "Offshore \u00b7 Open water",
                  "Rock/cliff \u00b7 Wave-swept platform",
                  "Other \u00b7 Harbour or inlet"
                ],
                "range": [
                  "#344e68",
                  "#9e2a25",
                  "#c46d58",
                  "#2d828c",
                  "#a37945",
                  "#837294"
                ]
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "slice",
                "type": "nominal",
                "title": "Sub-category"
              },
              {
                "field": "pct_total",
                "type": "quantitative",
                "title": "Share of all 150 deaths (%)",
                "format": ".1f"
              },
              {
                "field": "pct_parent",
                "type": "quantitative",
                "title": "Share of parent location (%)",
                "format": ".1f"
              },
              {
                "field": "count",
                "type": "quantitative",
                "title": "Deaths (n)"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "radius": 144,
            "font": "Source Sans 3, sans-serif",
            "fontSize": 10,
            "lineHeight": 11,
            "fontWeight": 700,
            "color": "#ffffff"
          },
          "encoding": {
            "theta": {
              "field": "count",
              "type": "quantitative",
              "stack": true
            },
            "order": {
              "field": "ord",
              "type": "quantitative"
            },
            "text": {
              "field": "outer_pct_str",
              "type": "nominal"
            }
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "t1": "150 deaths"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Source Sans 3, sans-serif",
        "fontSize": 13,
        "fontWeight": 600,
        "dy": -7,
        "color": "#1c2430"
      },
      "encoding": {
        "text": {
          "field": "t1",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "t2": "56.0% beach"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Source Sans 3, sans-serif",
        "fontSize": 11.5,
        "dy": 10,
        "color": "#7a1f1c"
      },
      "encoding": {
        "text": {
          "field": "t2",
          "type": "nominal"
        }
      }
    }
  ],
  "resolve": {
    "scale": {
      "color": "independent",
      "theta": "independent"
    }
  },
  "config": {
    "background": "#fffcf8",
    "font": "Source Sans 3, sans-serif",
    "axis": {
      "labelFont": "Source Sans 3, sans-serif",
      "titleFont": "Source Sans 3, sans-serif",
      "labelFontSize": 12.5,
      "titleFontSize": 12.5,
      "titleFontWeight": 600,
      "labelColor": "#1c2430",
      "titleColor": "#1c2430",
      "domainColor": "#bfb6aa",
      "tickColor": "#bfb6aa",
      "grid": false,
      "labelPadding": 6,
      "titlePadding": 8,
      "labelLimit": 220
    },
    "legend": {
      "labelFont": "Source Sans 3, sans-serif",
      "titleFont": "Source Sans 3, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#1c2430",
      "titleColor": "#1c2430",
      "symbolStrokeWidth": 0,
      "labelLimit": 240,
      "titleLimit": 280
    },
    "header": {
      "labelFont": "Source Sans 3, sans-serif",
      "titleFont": "Source Sans 3, sans-serif",
      "labelFontSize": 13.5,
      "labelColor": "#1c2430",
      "labelFontWeight": 600
    },
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Source Sans 3, sans-serif",
      "color": "#1c2430",
      "fontSize": 13.5,
      "fontWeight": 600,
      "subtitleFont": "Source Sans 3, sans-serif",
      "subtitleFontSize": 11.5,
      "subtitleColor": "#786f66",
      "anchor": "start"
    }
  }
}
