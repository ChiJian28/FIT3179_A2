{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Connected dumbbell chart comparing share of coastal drowning deaths within 1 km vs more than 1 km from an SLS service.",
  "width": 360,
  "height": 250,
  "padding": {
    "left": 12,
    "right": 20,
    "top": 10,
    "bottom": 10
  },
  "data": {
    "url": "data/distance.csv?v=31",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "100 - datum.beyond_pct",
      "as": "calc_within_pct"
    },
    {
      "calculate": "datum.beyond_pct + '%'",
      "as": "beyond_label"
    },
    {
      "calculate": "(100 - datum.beyond_pct) + '%'",
      "as": "within_label"
    }
  ],
  "encoding": {
    "y": {
      "field": "state",
      "type": "nominal",
      "sort": [
        "Tasmania",
        "South Australia",
        "Western Australia",
        "Queensland",
        "Victoria",
        "New South Wales"
      ],
      "title": null,
      "axis": {
        "domain": false,
        "ticks": false,
        "labelFontSize": 12.5
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#cbbab4",
        "strokeWidth": 3.5
      },
      "encoding": {
        "x": {
          "field": "calc_within_pct",
          "type": "quantitative",
          "title": "Share of coastal deaths (%) \u2014 Within 1 km (blue) vs. >1 km (red)",
          "scale": {
            "zero": true,
            "domain": [
              0,
              106
            ]
          },
          "axis": {
            "values": [
              0,
              20,
              40,
              60,
              69,
              80,
              100
            ]
          }
        },
        "x2": {
          "field": "beyond_pct"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "color": "#1d4e73",
        "size": 120,
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "calc_within_pct",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "calc_within_pct",
            "type": "quantitative",
            "title": "Within 1 km (%)"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "circle",
        "color": "#7a1f1c",
        "size": 150,
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "beyond_pct",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "beyond_pct",
            "type": "quantitative",
            "title": "More than 1 km away (%)"
          },
          {
            "field": "calc_within_pct",
            "type": "quantitative",
            "title": "Within 1 km (%)"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#7a1f1c",
        "strokeWidth": 1.5,
        "strokeDash": [
          4,
          3
        ]
      },
      "encoding": {
        "x": {
          "datum": 69
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.code == 'Tas' || datum.code == 'SA' || datum.code == 'NSW'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 9,
        "font": "Source Sans 3, sans-serif",
        "fontSize": 11.5,
        "fontWeight": 600,
        "color": "#7a1f1c"
      },
      "encoding": {
        "x": {
          "field": "beyond_pct",
          "type": "quantitative"
        },
        "text": {
          "field": "beyond_label",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.code == 'Tas' || datum.code == 'SA' || datum.code == 'NSW'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -9,
        "font": "Source Sans 3, sans-serif",
        "fontSize": 11.5,
        "fontWeight": 600,
        "color": "#1d4e73"
      },
      "encoding": {
        "x": {
          "field": "calc_within_pct",
          "type": "quantitative"
        },
        "text": {
          "field": "within_label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": "#fffcf8",
    "font": "Source Sans 3, sans-serif",
    "axis": {
      "labelFont": "Source Sans 3, sans-serif",
      "titleFont": "Source Sans 3, sans-serif",
      "labelFontSize": 12.5,
      "titleFontSize": 12.5,
      "titleFontWeight": 600,
      "labelColor": "#1c2430",
      "titleColor": "#1c2430",
      "domainColor": "#bfb6aa",
      "tickColor": "#bfb6aa",
      "grid": false,
      "labelPadding": 6,
      "titlePadding": 8,
      "labelLimit": 220
    },
    "legend": {
      "labelFont": "Source Sans 3, sans-serif",
      "titleFont": "Source Sans 3, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#1c2430",
      "titleColor": "#1c2430",
      "symbolStrokeWidth": 0,
      "labelLimit": 240,
      "titleLimit": 280
    },
    "header": {
      "labelFont": "Source Sans 3, sans-serif",
      "titleFont": "Source Sans 3, sans-serif",
      "labelFontSize": 13.5,
      "labelColor": "#1c2430",
      "labelFontWeight": 600
    },
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Source Sans 3, sans-serif",
      "color": "#1c2430",
      "fontSize": 13.5,
      "fontWeight": 600,
      "subtitleFont": "Source Sans 3, sans-serif",
      "subtitleFontSize": 11.5,
      "subtitleColor": "#786f66",
      "anchor": "start"
    }
  }
}
