{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Ten-year heatmap of coastal drowning rates per 100,000 people across Australian states (2014/15\u20132023/24) with selective milestone annotations.",
  "width": 780,
  "height": 290,
  "padding": {
    "left": 14,
    "right": 16,
    "top": 8,
    "bottom": 8
  },
  "data": {
    "url": "data/heatmap.csv?v=33",
    "format": {
      "type": "csv"
    }
  },
  "encoding": {
    "x": {
      "field": "fy",
      "type": "ordinal",
      "title": "Reporting season (1 July \u2013 30 June)",
      "axis": {
        "orient": "bottom",
        "labelAngle": 0,
        "labelFontSize": 12,
        "domain": false,
        "ticks": false
      }
    },
    "y": {
      "field": "state",
      "type": "nominal",
      "sort": [
        "Tasmania",
        "Western Australia",
        "New South Wales",
        "Queensland",
        "South Australia",
        "Victoria"
      ],
      "title": null,
      "axis": {
        "domain": false,
        "ticks": false,
        "labelFontSize": 12.5
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#fffcf8",
        "strokeWidth": 2
      },
      "encoding": {
        "color": {
          "field": "rate",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0.2,
              0.6,
              1.1,
              1.75
            ],
            "range": [
              "#f6ede8",
              "#df9a8c",
              "#b3443c",
              "#7a1f1c"
            ]
          },
          "legend": {
            "title": "Deaths per 100,000 people",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 200,
            "format": ".2f"
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "fy",
            "type": "nominal",
            "title": "Financial year"
          },
          {
            "field": "rate",
            "type": "quantitative",
            "title": "Rate per 100,000",
            "format": ".2f"
          },
          {
            "field": "deaths",
            "type": "quantitative",
            "title": "Coastal drowning deaths"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.note != '' && datum.note != null"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Source Sans 3, sans-serif",
        "fontSize": 11.5,
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "field": "note",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.rate >= 0.70",
            "value": "#ffffff"
          },
          "value": "#1c2430"
        }
      }
    }
  ],
  "config": {
    "background": "#fffcf8",
    "font": "Source Sans 3, sans-serif",
    "axis": {
      "labelFont": "Source Sans 3, sans-serif",
      "titleFont": "Source Sans 3, sans-serif",
      "labelFontSize": 12.5,
      "titleFontSize": 12.5,
      "titleFontWeight": 600,
      "labelColor": "#1c2430",
      "titleColor": "#1c2430",
      "domainColor": "#bfb6aa",
      "tickColor": "#bfb6aa",
      "grid": false,
      "labelPadding": 6,
      "titlePadding": 8,
      "labelLimit": 220
    },
    "legend": {
      "labelFont": "Source Sans 3, sans-serif",
      "titleFont": "Source Sans 3, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#1c2430",
      "titleColor": "#1c2430",
      "symbolStrokeWidth": 0,
      "labelLimit": 240,
      "titleLimit": 280
    },
    "header": {
      "labelFont": "Source Sans 3, sans-serif",
      "titleFont": "Source Sans 3, sans-serif",
      "labelFontSize": 13.5,
      "labelColor": "#1c2430",
      "labelFontWeight": 600
    },
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Source Sans 3, sans-serif",
      "color": "#1c2430",
      "fontSize": 13.5,
      "fontWeight": 600,
      "subtitleFont": "Source Sans 3, sans-serif",
      "subtitleFontSize": 11.5,
      "subtitleColor": "#786f66",
      "anchor": "start"
    }
  }
}
