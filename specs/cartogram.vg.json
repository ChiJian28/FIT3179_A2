{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Non-contiguous area cartogram. State polygon area is scaled to active patrolling members; colour shows the drowning rate class.",
  "width": 470,
  "height": 420,
  "padding": {
    "left": 10,
    "right": 10,
    "top": 10,
    "bottom": 10
  },
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -132,
      0
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/au-states.geojson?v=31",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e6f0f5",
        "stroke": "#b2c5d1",
        "strokeWidth": 1,
        "strokeDash": [
          3,
          3
        ]
      }
    },
    {
      "data": {
        "url": "data/cartogram.geojson?v=31",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1.3
      },
      "encoding": {
        "color": {
          "field": "properties.rate_class",
          "type": "nominal",
          "scale": {
            "domain": [
              "0.38\u20130.48",
              "0.69\u20130.73",
              "1.74",
              "No single-year rate"
            ],
            "range": [
              "#f3cfc9",
              "#c95b52",
              "#7a1f1c",
              "#e7e0d6"
            ]
          },
          "legend": {
            "title": "Deaths per 100,000 people",
            "orient": "bottom",
            "columns": 2,
            "direction": "horizontal",
            "labelLimit": 180
          }
        },
        "tooltip": [
          {
            "field": "properties.state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "properties.members",
            "type": "quantitative",
            "title": "Active patrolling members",
            "format": ","
          },
          {
            "field": "properties.clubs",
            "type": "quantitative",
            "title": "Surf Life Saving clubs"
          },
          {
            "field": "properties.hours",
            "type": "quantitative",
            "title": "Volunteer patrol hours",
            "format": ","
          },
          {
            "field": "properties.rate_class",
            "type": "nominal",
            "title": "Drowning rate class"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/states.csv?v=31",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/labels.csv?v=31",
              "format": {
                "type": "csv"
              }
            },
            "key": "state",
            "fields": [
              "lon",
              "lat"
            ]
          }
        },
        {
          "calculate": "datum.code + ' (' + format(datum.members, ',') + ')'",
          "as": "member_label"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Source Sans 3, sans-serif",
        "fontSize": 11.5,
        "fontWeight": 600,
        "color": "#1c2430"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "member_label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": "#d8e6ee",
    "font": "Source Sans 3, sans-serif",
    "axis": {
      "labelFont": "Source Sans 3, sans-serif",
      "titleFont": "Source Sans 3, sans-serif",
      "labelFontSize": 12.5,
      "titleFontSize": 12.5,
      "titleFontWeight": 600,
      "labelColor": "#1c2430",
      "titleColor": "#1c2430",
      "domainColor": "#bfb6aa",
      "tickColor": "#bfb6aa",
      "grid": false,
      "labelPadding": 6,
      "titlePadding": 8,
      "labelLimit": 220
    },
    "legend": {
      "labelFont": "Source Sans 3, sans-serif",
      "titleFont": "Source Sans 3, sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#1c2430",
      "titleColor": "#1c2430",
      "symbolStrokeWidth": 0,
      "labelLimit": 240,
      "titleLimit": 280
    },
    "header": {
      "labelFont": "Source Sans 3, sans-serif",
      "titleFont": "Source Sans 3, sans-serif",
      "labelFontSize": 13.5,
      "labelColor": "#1c2430",
      "labelFontWeight": 600
    },
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Source Sans 3, sans-serif",
      "color": "#1c2430",
      "fontSize": 13.5,
      "fontWeight": 600,
      "subtitleFont": "Source Sans 3, sans-serif",
      "subtitleFontSize": 11.5,
      "subtitleColor": "#786f66",
      "anchor": "start"
    }
  }
}
