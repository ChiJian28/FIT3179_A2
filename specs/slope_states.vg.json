{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Interactive slope chart of state coastal drowning rates from 2022/23 to 2023/24.",
  "width": 440,
  "height": 340,
  "padding": {
    "left": 14,
    "right": 24,
    "top": 10,
    "bottom": 10
  },
  "data": {
    "url": "data/slope_states.csv?v=31",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "datum.code + '  ' + format(datum.rate, '.2f') + ' (n=' + datum.deaths + ')'",
      "as": "calc_label"
    }
  ],
  "layer": [
    {
      "params": [
        {
          "name": "state_hover",
          "select": {
            "type": "point",
            "fields": [
              "state"
            ],
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 2.8
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "sort": [
            "2022/23",
            "2023/24"
          ],
          "title": null,
          "scale": {
            "padding": 0.35
          },
          "axis": {
            "labelFontSize": 13,
            "labelFontWeight": 600,
            "labelAngle": 0
          }
        },
        "y": {
          "field": "rate",
          "type": "quantitative",
          "title": "Deaths per 100,000 people",
          "scale": {
            "zero": true,
            "domain": [
              0,
              1.9
            ]
          },
          "axis": {
            "tickCount": 5
          }
        },
        "detail": {
          "field": "state",
          "type": "nominal"
        },
        "color": {
          "condition": [
            {
              "param": "state_hover",
              "empty": false,
              "value": "#7a1f1c"
            },
            {
              "test": "datum.code == 'Tas' || datum.code == 'NSW'",
              "value": "#7a1f1c"
            }
          ],
          "value": "#b8a6a1"
        },
        "opacity": {
          "condition": {
            "param": "state_hover",
            "value": 1
          },
          "value": 0.9
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "year",
            "type": "nominal",
            "title": "Year"
          },
          {
            "field": "rate",
            "type": "quantitative",
            "title": "Rate per 100k",
            "format": ".2f"
          },
          {
            "field": "deaths",
            "type": "quantitative",
            "title": "Coastal deaths"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 80,
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "sort": [
            "2022/23",
            "2023/24"
          ]
        },
        "y": {
          "field": "rate",
          "type": "quantitative"
        },
        "color": {
          "condition": {
            "test": "datum.code == 'Tas' || datum.code == 'NSW'",
            "value": "#7a1f1c"
          },
          "value": "#9e8f89"
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "year",
            "type": "nominal",
            "title": "Year"
          },
          {
            "field": "rate",
            "type": "quantitative",
            "title": "Rate per 100k",
            "format": ".2f"
          },
          {
            "field": "deaths",
            "type": "quantitative",
            "title": "Coastal deaths"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.code == 'Tas' && datum.year == '2023/24'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "dy": 0,
        "font": "Source Sans 3, sans-serif",
        "fontSize": 11.5,
        "fontWeight": 600,
        "color": "#7a1f1c"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "sort": [
            "2022/23",
            "2023/24"
          ]
        },
        "y": {
          "field": "rate",
          "type": "quantitative"
        },
        "text": {
          "field": "calc_label",
          "type": "nominal"
        }
      }
    },
